# How the files here are laid out, for editors that read this (most do).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Caddyfile]
indent_style = tab

# Other people's licence texts, kept exactly as they came.
[{LICENSE,web/fonts/licences/*}]
charset = unset
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = unset
